# Google Maps Platform API Key (Map Tiles API & Maps JavaScript API enabled)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Mapbox Public Access Token & Tileset ID for Boston 500-Year Flood Cells
VITE_MAPBOX_ACCESS_TOKEN=your_mapbox_access_token
VITE_MAPBOX_TILESET_ID=your_mapbox_tileset_id

# SPA Authentication (Public App Client — no client secret)
VITE_COGNITO_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=your_user_pool_id
VITE_COGNITO_CLIENT_ID=your_spa_client_id
